# Production environment template. Copy to .env on the server and fill in real
# secrets. The important differences from .env.example are at the top.

APP_NAME="Auth Service"
APP_ENV=production
APP_KEY=
# Never enable debug in production: it leaks stack traces and config.
APP_DEBUG=false
APP_URL=https://auth.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Cost factor for bcrypt. 12 is a reasonable production baseline.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=auth_service
DB_USERNAME=auth_service
# Use a strong, unique value and keep it out of version control.
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Passport token lifetimes (days).
PASSPORT_PERSONAL_ACCESS_TOKEN_TTL_DAYS=15
PASSPORT_ACCESS_TOKEN_TTL_DAYS=1
PASSPORT_REFRESH_TOKEN_TTL_DAYS=30

# In production, prefer supplying the Passport keys via environment variables
# rather than files on disk. The production Compose file requires both because
# its immutable app image intentionally contains no storage/*.key secrets.
# Preserve PEM newlines with a quoted multiline value or your secret manager's
# equivalent injection mechanism.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
